# URL pública do site (https em produção; usada nos retornos do Mercado Pago e e-mails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Porta do servidor (a Hostinger define automaticamente)
# PORT=3000

# --- Supabase (Project Settings → API). Sem estas chaves, o site usa .data/db.json (somente dev) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Painel ---
# E-mails autorizados (usuários criados em Supabase → Authentication), separados por vírgula
ADMIN_EMAILS=
# Apenas no modo local (sem Supabase): senha do painel e segredo dos cookies
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=troque-por-uma-string-aleatoria-longa

# --- Mercado Pago (Suas integrações → Credenciais). Sem token, o pagamento é simulado em dev ---
MERCADOPAGO_ACCESS_TOKEN=
# Suas integrações → Webhooks → "Assinatura secreta" (evento: Pagamentos)
MERCADOPAGO_WEBHOOK_SECRET=

# --- Melhor Envio (Configurações → Permissões de acesso → Gerar token). Sem token, frete simulado em dev ---
MELHOR_ENVIO_TOKEN=
MELHOR_ENVIO_SANDBOX=true
# Exigido pelo Melhor Envio: "Nome da aplicação (email de contato)"
MELHOR_ENVIO_USER_AGENT=Mali Personalize (contato@malipersonalize.com.br)

# --- E-mails pela caixa da Hostinger (hPanel → E-mails). Sem SMTP, os e-mails só vão para o log ---
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=pedidos@malipersonalize.com.br
SMTP_PASS=
EMAIL_FROM=Mali Personalizê <pedidos@malipersonalize.com.br>
# Recebe aviso de cada pedido pago (e é o "responder para" dos e-mails aos clientes)
STORE_NOTIFY_EMAIL=contato@malipersonalize.com.br
